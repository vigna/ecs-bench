# Style of the figures generated by 'bench/run.py plot', which loads this
# file explicitly (so it applies whatever the current directory).

# TeX's Computer Modern, bundled with matplotlib, for text and math; the
# tick labels must be typeset as math, as cmr10 has no minus sign
font.family: serif
font.serif: cmr10
mathtext.fontset: cm
axes.formatter.use_mathtext: True
axes.unicode_minus: False

# 15% larger than the default, as figures are scaled down to half the
# width of the text
font.size: 11.5
