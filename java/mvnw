#!/bin/sh
# Maven Wrapper script — downloads Maven if not already cached, then delegates.
# See https://maven.apache.org/wrapper/

set -e

MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-$(cd "$(dirname "$0")" && pwd)}"
MAVEN_WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
MAVEN_WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

if [ -f "$MAVEN_WRAPPER_PROPERTIES" ]; then
  distributionUrl=$(grep 'distributionUrl' "$MAVEN_WRAPPER_PROPERTIES" | cut -d= -f2-)
fi

MAVEN_USER_HOME="${MAVEN_USER_HOME:-$HOME/.m2}"
MAVEN_HOME="$MAVEN_USER_HOME/wrapper/dists/$(basename "$distributionUrl" .zip)"

if [ ! -d "$MAVEN_HOME" ]; then
  echo "Downloading Maven from $distributionUrl"
  mkdir -p "$MAVEN_HOME"
  tmpfile=$(mktemp)
  curl -sL -o "$tmpfile" "$distributionUrl"
  unzip -qo "$tmpfile" -d "$MAVEN_HOME"
  rm -f "$tmpfile"
fi

MVN_CMD=$(find "$MAVEN_HOME" -name mvn -type f -path '*/bin/mvn' | head -1)
if [ -z "$MVN_CMD" ]; then
  echo "Error: could not find mvn binary in $MAVEN_HOME" >&2
  exit 1
fi

exec "$MVN_CMD" "$@"
